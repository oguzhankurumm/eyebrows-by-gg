  "narrative": {
    "northStar": "The Personal Beauty Studio",
    "overview": "A personal beauty studio expressed through lilac-white space, lavender panels, violet actions and generous curved photography. Sora gives the studio a confident voice; Manrope keeps treatment information and booking controls approachable. The exact brand slogan is “Let’s touch your beauty”.\n\nThis is the implemented rounded studio world, selected through user feedback and extracted from the current code. Original client photographs and published studio Instagram media provide the visual detail. The historical seed is unverified and is not current direction authority; there is no approved comp or qualitycard.",
    "keyCharacteristics": [
      "Rounded image-led sections and treatment cards.",
      "Interactive finish previews, treatment filters and real before/after comparison.",
      "Four mobile destinations with a separate booking action.",
      "Purposeful arrival, reveal and interaction motion with reduced-motion support."
    ],
    "rules": [
      {
        "name": "Five Roles",
        "body": "Use background for the page and inset controls, surface for grouping, text for primary reading, accent for actions and selected states, and muted for supporting copy. Derived transparencies remain attached to these roles.",
        "section": "colors"
      },
      {
        "name": "Two Voices",
        "body": "Use Sora for display and headings, and Manrope for reading and controls. Preserve the slogan’s curly apostrophe.",
        "section": "typography"
      },
      {
        "name": "Purposeful Lift",
        "body": "Use soft elevation for floating previews, mobile navigation and the booking dialog; use hover lift to acknowledge actionable cards and buttons.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the five semantic palette roles and the two locally loaded font families.",
      "Do preserve the exact slogan “Let’s touch your beauty”.",
      "Do use original client and published studio media with provenance; preserve truthful before/after pairing.",
      "Do keep visible keyboard focus, native controls, safe-area spacing and reduced-motion behavior.",
      "Do preserve four mobile destinations and the separate booking action.",
      "Do keep historical original-site reference material internal."
    ],
    "donts": [
      "Don’t restore the rejected shade-library or magazine-cover direction.",
      "Don’t invent synthetic treatment results, reviews, credentials or current prices.",
      "Don’t replace the inline booking radio list with a browser select popup.",
      "Don’t iframe or proxy GlossGenius; preserve the separate secure booking window and manual new-tab fallback.",
      "Don’t apply desktop hover lifts or smooth-wheel behavior to touch interaction."
    ]
  }
